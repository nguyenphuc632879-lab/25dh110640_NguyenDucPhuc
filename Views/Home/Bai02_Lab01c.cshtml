@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Trang Đăng Nhập</title>
</head>
<body>

   
    <form action="https://www.google.com" method="POST" style="border-left: 4px solid #eee; padding-left: 15px; font-family: Arial, sans-serif;">

        <h2>Thông tin đăng nhập sinh viên</h2>

        <div style="margin-bottom: 5px;">Mã số sinh viên:</div>
        <input type="text" name="mssv" value="17dh110123" style="margin-bottom: 15px; width: 200px;">

        <div style="margin-bottom: 5px;">Mật khẩu:</div>
        <input type="password" name="matkhau" style="margin-bottom: 15px; width: 200px;"><br>

        <div style="margin-bottom: 15px;">
            <input type="checkbox" name="luu_thong_tin" id="luu_thong_tin">
            <label for="luu_thong_tin">Lưu thông tin đăng nhập.</label>
        </div>

        <div style="margin-bottom: 15px;">
            <input type="submit" value="Đăng nhập">
        </div>

        
        <div>
            Sử dụng thông tin đăng nhập do trường cấp, nếu quên mật khẩu thì nhấn vào <a href="repass.html">đây</a>.
        </div>

    </form>

</body>
</html>
