@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
</head>
<body>
    <div style="width: 100%; border: 1px solid #000; box-sizing: border-box;">
      
        <div style="width: 100%; height: 60px; border-bottom: 1px solid #000; text-align: center; line-height: 60px;">
            Header
        </div>

       
        <div style="display: flex; min-height: 250px;">
     
            <div style="width: 25%; border-right: 1px solid #000; text-align: center; padding-top: 20px;">
                Sidebar
            </div>
           
            <div style="width: 75%; text-align: center; padding-top: 20px;">
                Main Content
            </div>
        </div>

     
        <div style="width: 100%; height: 60px; border-top: 1px solid #000; text-align: center; line-height: 60px;">
            Footer
        </div>
    </div>
</body>
</html>
