@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Lấy Lại Mật Khẩu</title>
</head>
<body>


    <form action="https://www.google.com" method="POST" style="font-family: Arial, sans-serif;">

     
        <fieldset style="width: 400px; padding: 15px; border: 1px solid #ccc;">
            <legend>Lấy lại mật khẩu:</legend>

            <div style="margin-bottom: 5px;">Mã số sinh viên:</div>
            <input type="text" name="mssv" value="19dh110123" style="margin-bottom: 10px; width: 200px;">

            <div style="margin-bottom: 5px;">Mật khẩu cũ:</div>
            <input type="password" name="matkhaucu" style="margin-bottom: 10px; width: 200px;">

            <div style="margin-bottom: 5px;">Mật khẩu mới:</div>
            <input type="password" name="matkhaumoi" style="margin-bottom: 10px; width: 200px;">

            <div style="margin-bottom: 5px;">Nhập lại Mật khẩu mới:</div>
            <input type="password" name="nhaplaimatkhaumoi" style="margin-bottom: 20px; width: 200px;"><br>

            <div>
                <input type="submit" value="Lưu lại">
            </div>

        </fieldset>

    </form>

</body>
</html>